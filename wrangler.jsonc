{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ehsansofyan",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "aa6a8187-9cde-45a1-8f39-d331d74689f1","database_name": "ehsansofyan" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5bcae34168fc41199da9618fe4a5584c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
